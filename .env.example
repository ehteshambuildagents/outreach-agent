# Saqua environment template
# Copy to .env for the backend and to saqua-frontend/.env.local or your Vercel
# project variables for the frontend. Use placeholder values only in this file.

# ---------------------------------------------------------------------------
# Backend: required for AI calls
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Anthropic model routing
FAST_MODEL=claude-haiku-4-5
QUALITY_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Backend: optional research/discovery providers
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
BRAVE_API_KEY=

# X (Twitter) recent search — OPTIONAL recent-social-signal source. Read-only,
# App-only Bearer auth; costs money per read (no free tier), so it's cached and
# only runs when a request needs recent social signal. Backend-only, never
# client-side. No Consumer Key/Secret needed until posting (a later phase).
X_BEARER_TOKEN=
# Optional overrides (defaults: 25 / 21600s / 0.005): estimate only, not billing.
X_SEARCH_MAX_RESULTS=25
X_SEARCH_CACHE_TTL_SECONDS=21600
X_SEARCH_COST_PER_READ_USD=0.005

# Apollo. ONE key, TWO independent integrations — set it on every backend service.
#
#  1. DISCOVERY (organization search + verified job postings) — the PRIMARY source
#     of companies, ON by default (APOLLO_ORG_SEARCH_ENABLED=1). Without this key
#     discovery does not fail, it silently falls back to web search alone: no
#     verified job postings, no recruiter/staffing filtering, materially weaker
#     ranking. Production shipped that way once, so check /api/admin/providers
#     (booleans only) or the "discovery providers:" startup log after a deploy.
#  2. People-Match enrichment — OPTIONAL verified-contact source (name + domain ->
#     verified email + title). Costs credits per match, so it is metered and OFF
#     by default: set APOLLO_ENRICH_ENABLED=1 to allow it.
#
# Backend-only, never client-side; rotate the key in Apollo's console if exposed.
APOLLO_API_KEY=
APOLLO_ENRICH_ENABLED=0
# Source planner's paid recency escalation (Tavily news + X search) for prospects
# with no recent on-site signal. Kill switch, OFF by default until watched on real
# campaigns. Apollo has its own gate (APOLLO_ENRICH_ENABLED) above.
PLANNER_ESCALATION_ENABLED=0

# ---------------------------------------------------------------------------
# Backend: auth
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# ---------------------------------------------------------------------------
# Frontend: public Clerk variables
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Frontend API proxy target. Local dev defaults to http://127.0.0.1:8000.
SAQUA_API_ORIGIN=http://127.0.0.1:8000

# Public product origin for browser redirects after OAuth.
FRONTEND_URL=http://localhost:3200

# Backend API origin used when deriving OAuth callback URLs. In production this
# should be the API host, e.g. https://api.saqua.io.
APP_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Database / persistence
# ---------------------------------------------------------------------------
# Production should use Postgres/Supabase. Local dev falls back to SQLite when
# DATABASE_URL is empty.
DATABASE_URL=
AUTOMATION_FORCE_SQLITE=0
AUTOMATION_DB_PATH=automation.db
# Safety: the test suite is BLOCKED from opening a Postgres connection (it would
# hit prod). Set this to 1 ONLY for a test/script that genuinely must touch a
# real database. Leave unset/0 everywhere else.
AUTOMATION_ALLOW_PROD_DB=0

# ---------------------------------------------------------------------------
# Automation / token storage
# ---------------------------------------------------------------------------
AUTOMATION_ENC_KEY=<long-random-encryption-key>
AUTOMATION_WORKER_ENABLED=0
AUTOMATION_WEBHOOK_SECRET=<shared-webhook-secret>

# Redis/Upstash for locks, dedupe, and rate limits. Local dev has an in-memory
# fallback when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Gmail OAuth / reply detection
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/gmail/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_TOKEN=<shared-gmail-pubsub-token>

# ---------------------------------------------------------------------------
# Microsoft Outlook OAuth / reply detection
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=<your-microsoft-client-id>
MICROSOFT_CLIENT_SECRET=<your-microsoft-client-secret>
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/oauth/outlook/callback
GRAPH_WEBHOOK_URL=
GRAPH_CLIENT_STATE=<shared-graph-client-state>

# ---------------------------------------------------------------------------
# Telemetry / logging
# ---------------------------------------------------------------------------
SAQUA_LOG_LEVEL=INFO
TELEMETRY_DISABLED=0
TELEMETRY_SYNC=0

# ---------------------------------------------------------------------------
# Guard budgets
# ---------------------------------------------------------------------------
GUARD_DAILY_BUDGET_USD=10
GUARD_MONTHLY_BUDGET_USD=200

# ---------------------------------------------------------------------------
# Waitlist (public signup + double opt-in confirmation via Resend)
# ---------------------------------------------------------------------------
# Sending is OFF until BOTH of these are set: with either missing, a signup still
# returns 200 and the address is stored, but no confirmation email is ever sent.
RESEND_API_KEY=<your-resend-api-key>
# Must be on a domain verified in Resend, or every send fails.
WAITLIST_FROM_EMAIL=hello@saqua.io

# Base URL for the confirmation links in those emails. Defaults to
# https://saqua.io when unset; override for local/staging.
SAQUA_SITE_URL=http://localhost:3200

# The public signup endpoint refuses to serve (503) in production unless shared
# Redis is configured above, because a public write endpoint whose rate limiting
# silently degrades to per-process state is not safe. Set to 0 to override.
WAITLIST_REQUIRE_SHARED_REDIS=1

# ---------------------------------------------------------------------------
# Frontend proxy identity (per-visitor rate limiting)
# ---------------------------------------------------------------------------
# Requests reaching the API through the Next.js proxy arrive with the proxy's own
# address: Railway's edge rewrites X-Forwarded-For on ingress, so the visitor's IP
# cannot be recovered from it at any offset. The proxy therefore passes the address
# explicitly, and signs that it is really ours with this shared secret — without
# which anyone could post a client IP of their choice to the public API host and
# mint unlimited fresh rate-limit buckets.
#
# Set the SAME value on the frontend (Vercel) and the backend. When unset, proxied
# traffic all shares one bucket: over-restrictive, never permissive.
SAQUA_PROXY_SECRET=<long-random-shared-secret>
