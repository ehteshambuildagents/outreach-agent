# Streamlit secrets TEMPLATE.
#
# LOCAL: copy this file to ".streamlit/secrets.toml" and paste your real key,
#        OR just keep using the project's .env file — either works.
# CLOUD: do NOT upload this file. Paste the line below into the Streamlit Cloud
#        dashboard at  App → Settings → Secrets.
#
# The real ".streamlit/secrets.toml" is git-ignored and must NEVER be committed.

ANTHROPIC_API_KEY = "<your-anthropic-api-key>"
