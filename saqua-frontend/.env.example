# ─────────────────────────────────────────────────────────────────────────────
# Saqua frontend environment
# Copy to .env.local for development. Set the same keys in your host (e.g. Vercel)
# Project Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# Backend origin the built-in /api proxy (src/app/api/[...path]/route.ts) forwards to.
#   • Local dev: your FastAPI (uvicorn). If unset in development, the proxy falls
#     back to http://127.0.0.1:8000. Set this if your backend runs elsewhere.
#   • Production: REQUIRED. Point at your deployed backend, e.g.
#         https://saqua-api.up.railway.app
#     If unset in production, /api requests return a clear 500 (never localhost).
# Server-side only (not exposed to the browser) — do NOT prefix with NEXT_PUBLIC_.
SAQUA_API_ORIGIN=http://127.0.0.1:8000

# ── Clerk auth ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/ai
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/ai
